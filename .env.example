# Platform configuration for foundry. Copy to .env; .env is gitignored.
#
# App configuration (DATABASE_URL, GOOGLE_*, SNIPPET_ADDR, ...) belongs in the
# app repository's .env, not here. Terraform ignores those names.

# Cloudflare API token: Zone:Read and Zone:DNS:Edit on the one zone.
CLOUDFLARE_API_TOKEN=

# Terraform reads this as var.alert_email in terraform/alerts. Empty creates
# the topic with no subscriber, which is valid and wrong for production.
TF_VAR_alert_email=

# Optional. The Makefile defaults the region to ap-southeast-2; AWS SSO picks
# the profile from your shell if you have one.
# AWS_PROFILE=your-sso-profile
